{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "invalid_api_key": "[%key:common::config_flow::error::invalid_api_key%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "tv_code": "[%key:common::config_flow::data::tv_code%]"
        },
        "description": "YouTube Lounge needs to re-authenticate",
        "title": "[%key:common::config_flow::title::reauth%]"
      },
      "user": {
        "data": {
          "tv_code": "[%key:common::config_flow::data::tv_code%]"
        }
      }
    }
  },
  "exceptions": {
    "play_next_unsupported": {
      "message": "Play next is not supported"
    }
  },
  "services": {
    "connect": {
      "description": "Manually try to (re-)connect.",
      "fields": {
        "entity_id": {
          "description": "YTLounge entity to connect.",
          "name": "Entity"
        }
      },
      "name": "Connect"
    },
    "get_now_playing": {
      "description": "get_now_playing",
      "fields": {
        "entity_id": {
          "description": "YTLounge entity",
          "name": "Entity"
        }
      },
      "name": "get_now_playing"
    },
    "subscribe": {
      "description": "Manually force (re-)subscribe.",
      "fields": {
        "entity_id": {
          "description": "YTLounge entity to subscribe.",
          "name": "Entity"
        }
      },
      "name": "Subscribe"
    },
    "raw_command": {
      "description": "Send raw YouTube Lounge API command.",
      "fields": {
        "entity_id": {
          "description": "YTLounge entity to connect.",
          "name": "Entity"
        },
        "command": {
          "description": "Command name",
          "name": "Command"
        },
        "args": {
          "description": "Command arguments",
          "name": "Arguments"
        }
      },
      "name": "Raw Command"
    }
  }
}
